# Copia este archivo como .env en el servidor y completa valores privados.
# No publiques el .env real ni reutilices una clave de ejemplo.
SECRET_KEY=
# Usa true cuando el acceso público funcione mediante HTTPS.
COOKIE_SECURE=false
# Si queda vacío, se utiliza SQL Server Express local con autenticación Windows.
# Para un servidor remoto, configura aquí su URI SQLAlchemy de forma privada.
DATABASE_URL=
